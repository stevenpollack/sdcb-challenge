# Copy to .env.local. The evaluator provides real test-user credentials at run time.
# .env.local is gitignored and must never be committed.
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_A=@your-test-user:matrix.org
MATRIX_PASSWORD_A=replace-me
MATRIX_USER_B=@your-test-user:matrix.org
MATRIX_PASSWORD_B=replace-me
